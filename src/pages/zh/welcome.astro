---
import Base from '@/layouts/Base.astro';
import LandingHero from '@/components/LandingHero.astro';
import { tr } from '@/lib/i18n';

const lang = 'zh' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = `${tr('siteName', lang)} — 韩国旅行一目了然`;
const desc = '13,000个精选,4种语言,实时天气 — 你的韩国旅游指南';
---

<Base title={title} description={desc} lang={lang} canonicalPath="/zh/welcome/" ogImage="/og-image.svg">
  <LandingHero lang={lang} base={base} />
</Base>
