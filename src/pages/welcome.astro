---
import Base from '@/layouts/Base.astro';
import LandingHero from '@/components/LandingHero.astro';
import { tr } from '@/lib/i18n';

const lang = 'ko' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const title = `${tr('siteName', lang)} — 한국 여행, 한눈에`;
const desc = '13,000개 큐레이션, 4개 언어, 실시간 날씨로 만나는 한국 여행 가이드';
---

<Base title={title} description={desc} lang={lang} canonicalPath="/welcome/" ogImage="/og-image.svg">
  <LandingHero lang={lang} base={base} />
</Base>
