---
import Base from '@/layouts/Base.astro';
import AdSlot from '@/components/AdSlot.astro';
import ItemCard from '@/components/ItemCard.astro';
import {
  DNA_QUESTIONS, DNA_PERSONAS, DNA_CODES, AXES,
  getAllDnaRecommendations, dnaT,
} from '@/lib/quiz-dna';
import { tr } from '@/lib/i18n';

const lang = 'en' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const recs = getAllDnaRecommendations();

const title = `${dnaT('pageTitle', lang)} | ${tr('siteName', lang)}`;
const desc = dnaT('pageDesc', lang);
---

<Base title={title} description={desc} lang={lang} canonicalPath="/en/quiz/dna/" ogImage="/og-quiz.svg">
  <section id="dna-app" data-lang={lang} class="dna-app">

    <!-- 1. Intro -->
    <div class="dna-screen dna-intro" data-screen="intro">
      <div class="dna-intro-emoji">🧬</div>
      <p class="dna-intro-eyebrow">PROFESSIONAL TRAVEL ANALYSIS</p>
      <h1 class="dna-intro-title">{dnaT('pageTitle', lang)}</h1>
      <p class="dna-intro-desc">{dnaT('pageDesc', lang)}</p>
      <ul class="dna-axes-preview">
        {AXES.map((a) => (
          <li><strong>{a.highCode}</strong>·<strong>{a.lowCode}</strong> {a.axisLabel[lang]}</li>
        ))}
      </ul>
      <p class="dna-intro-meta">{dnaT('startCta', lang)}</p>
      <button type="button" class="btn dna-start-btn" id="dna-start-btn">{dnaT('start', lang)} →</button>
    </div>

    <!-- 2. Questions -->
    <div class="dna-screen dna-questions" data-screen="questions" hidden>
      <div class="dna-progress">
        <div class="dna-progress-bar"><div class="dna-progress-fill" id="dna-progress-fill"></div></div>
        <p class="dna-progress-text"><span id="dna-q-current">1</span><span>{dnaT('questionOf', lang)}</span></p>
      </div>
      {DNA_QUESTIONS.map((q, idx) => (
        <div class="dna-question" data-q-index={idx} hidden={idx > 0}>
          <h2 class="dna-q-text">{q.question[lang]}</h2>
          <div class="dna-options">
            {q.options.map((o) => (
              <button type="button" class="dna-option" data-option-id={o.id}>{o.label[lang]}</button>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- 3. Result — 16개 코드 블록을 모두 임베드, JS가 일치하는 것만 표시 -->
    {DNA_CODES.map((code) => {
      const p = DNA_PERSONAS[code];
      const items = recs[code];
      return (
        <div class="dna-screen dna-result" data-screen="result" data-code={code} hidden>
          <a href={`${base}/en/quiz/`} class="dna-back">← {tr('siteName', lang)}</a>

          <div class="dna-result-card" style={`background: linear-gradient(135deg, ${p.gradient.from}, ${p.gradient.to});`}>
            <p class="dna-result-label">{dnaT('yourCode', lang)}</p>
            <div class="dna-result-code" aria-label={code}>
              {code.split('').map((c) => <span class="dna-code-char">{c}</span>)}
            </div>
            <div class="dna-result-emoji">{p.emoji}</div>
            <h1 class="dna-result-name">{p.name[lang]}</h1>
            <p class="dna-result-tagline">"{p.tagline[lang]}"</p>
          </div>

          <!-- 4축 막대 차트 — JS가 실제 백분율로 채움 (정적 마크업은 0%) -->
          <section class="dna-axes">
            <h2 class="dna-h">{dnaT('axisBreakdown', lang)}</h2>
            {AXES.map((a) => {
              const isHigh = code[AXES.indexOf(a)] === a.highCode;
              return (
                <div class="dna-axis-row" data-axis={a.key}>
                  <div class="dna-axis-labels">
                    <span class={`dna-axis-end ${isHigh ? 'is-on' : ''}`}>{a.highName[lang]}</span>
                    <span class="dna-axis-pct" data-pct="0">—</span>
                    <span class={`dna-axis-end ${!isHigh ? 'is-on' : ''}`}>{a.lowName[lang]}</span>
                  </div>
                  <div class="dna-axis-bar">
                    <div class="dna-axis-fill" data-axis-fill={a.key} style="width: 50%"></div>
                  </div>
                </div>
              );
            })}
          </section>

          <p class="dna-desc">{p.description[lang]}</p>

          <div class="dna-actions">
            <button type="button" class="btn-share dna-share-btn" data-share-action="native">↗ {dnaT('share', lang)}</button>
            <button type="button" class="btn-share dna-share-btn" data-share-action="copy">📋 {dnaT('shareCopy', lang)}</button>
          </div>

          <AdSlot lang={lang} layout="horizontal" />

          <section class="dna-recs">
            <h2 class="section-title">{dnaT('recommendations', lang)}</h2>
            <div class="grid">
              {items.map((item) => <ItemCard item={item} lang={lang} base={base} />)}
            </div>
          </section>

          <AdSlot lang={lang} layout="rectangle" />

          <div class="dna-retake">
            <button type="button" class="btn dna-retake-btn">↻ {dnaT('retake', lang)}</button>
          </div>
        </div>
      );
    })}
  </section>

  <script>
    import { initDna } from '@/scripts/quiz-dna.client';
    const root = document.getElementById('dna-app');
    if (root) initDna(root);
  </script>

  <style>
    .dna-app { max-width: 880px; margin: 0 auto; padding: 24px 16px 80px; }
    .dna-intro { text-align: center; padding: 48px 16px; }
    .dna-intro-emoji { font-size: 64px; line-height: 1; margin-bottom: 12px; }
    .dna-intro-eyebrow { color: #737373; font-size: 0.78rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; margin: 0 0 8px; }
    .dna-intro-title { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 0 0 12px; letter-spacing: -0.02em; font-weight: 800; }
    .dna-intro-desc { color: #525252; margin: 0 0 20px; line-height: 1.55; max-width: 560px; margin-left: auto; margin-right: auto; }
    .dna-axes-preview { list-style: none; padding: 0; margin: 0 auto 24px; max-width: 420px; display: grid; gap: 6px; font-size: 0.88rem; color: #525252; }
    .dna-axes-preview li { background: #fafafa; padding: 8px 14px; border-radius: 10px; border: 1px solid #f0f0f0; }
    .dna-axes-preview strong { color: #facc15; font-weight: 800; background: #171717; padding: 1px 6px; border-radius: 4px; margin-right: 2px; }
    .dna-intro-meta { color: #a3a3a3; font-size: 0.85rem; margin: 0 0 24px; }
    .dna-start-btn { font-size: 1.05rem; padding: 14px 32px; background: #171717; color: #facc15; border-radius: 999px; border: 0; font-weight: 800; cursor: pointer; }
    .dna-start-btn:hover { background: #000; }

    .dna-progress { margin-bottom: 32px; }
    .dna-progress-bar { height: 6px; background: #f0f0f0; border-radius: 999px; overflow: hidden; }
    .dna-progress-fill { height: 100%; background: #facc15; border-radius: 999px; width: 12.5%; transition: width 0.3s ease; }
    .dna-progress-text { margin: 8px 0 0; font-size: 0.85rem; color: #737373; text-align: center; }

    .dna-q-text { font-size: clamp(1.2rem, 3vw, 1.55rem); margin: 0 0 24px; line-height: 1.35; }
    .dna-options { display: flex; flex-direction: column; gap: 12px; }
    .dna-option { width: 100%; text-align: left; padding: 18px 20px; background: #fff; border: 2px solid #e5e5e5; border-radius: 14px; font-size: 1rem; font-weight: 500; cursor: pointer; line-height: 1.4; font-family: inherit; }
    .dna-option:hover { border-color: #171717; }
    .dna-option.is-selected { border-color: #facc15; background: #fefce8; }

    .dna-back { display: inline-block; color: #525252; text-decoration: none; font-size: 0.88rem; margin-bottom: 12px; }
    .dna-back:hover { color: #171717; }

    .dna-result-card { text-align: center; padding: 36px 24px 32px; border-radius: 24px; color: #fff; box-shadow: 0 8px 32px rgba(0,0,0,0.18); margin-bottom: 24px; }
    .dna-result-label { color: rgba(255,255,255,0.75); font-size: 0.78rem; margin: 0 0 12px; letter-spacing: 0.12em; text-transform: uppercase; font-weight: 700; }
    .dna-result-code { font-size: clamp(2.8rem, 7vw, 4rem); font-weight: 900; letter-spacing: 0.08em; margin: 4px 0 12px; line-height: 1; font-family: 'Pretendard', system-ui, sans-serif; }
    .dna-code-char { display: inline-block; padding: 2px 8px; margin: 0 1px; background: rgba(0,0,0,0.18); border-radius: 8px; }
    .dna-result-emoji { font-size: 60px; line-height: 1; margin: 16px 0 8px; }
    .dna-result-name { font-size: clamp(1.5rem, 4vw, 2rem); margin: 0 0 8px; font-weight: 800; letter-spacing: -0.02em; }
    .dna-result-tagline { font-size: 1rem; color: rgba(255,255,255,0.95); font-style: italic; margin: 0; }

    .dna-h { font-size: 1rem; margin: 0 0 12px; font-weight: 700; letter-spacing: -0.01em; }
    .dna-axes { background: #fafafa; border: 1px solid #f0f0f0; border-radius: 14px; padding: 16px 18px; margin-bottom: 24px; }
    .dna-axis-row { padding: 8px 0; }
    .dna-axis-row + .dna-axis-row { border-top: 1px solid #f0f0f0; }
    .dna-axis-labels { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; font-size: 0.85rem; color: #737373; }
    .dna-axis-end { font-weight: 500; }
    .dna-axis-end.is-on { color: #171717; font-weight: 800; }
    .dna-axis-pct { font-feature-settings: "tnum"; font-weight: 700; color: #171717; font-size: 0.88rem; }
    .dna-axis-bar { height: 8px; background: #e5e5e5; border-radius: 999px; overflow: hidden; position: relative; }
    .dna-axis-fill { display: block; height: 100%; background: linear-gradient(90deg, #facc15, #f59e0b); border-radius: 999px; transition: width 0.6s ease; }

    .dna-desc { color: #525252; line-height: 1.65; margin: 0 0 24px; font-size: 0.95rem; text-align: center; max-width: 620px; margin-left: auto; margin-right: auto; }

    .dna-actions { display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-bottom: 32px; }
    .btn-share { background: #171717; color: #fff; border: 0; padding: 10px 18px; border-radius: 999px; font-weight: 700; cursor: pointer; font-size: 0.88rem; }
    .btn-share[data-share-action="copy"] { background: #facc15; color: #171717; }

    .dna-recs { margin: 24px 0; }
    .dna-recs .section-title { font-size: 1.25rem; margin: 0 0 16px; letter-spacing: -0.015em; }
    .dna-retake { text-align: center; margin-top: 32px; }
    .dna-retake-btn { background: transparent; color: #171717; border: 1px solid #e5e5e5; padding: 12px 24px; border-radius: 999px; font-weight: 700; cursor: pointer; }
    .dna-retake-btn:hover { background: #fafafa; }
  </style>
</Base>
