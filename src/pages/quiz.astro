---
import Base from '@/layouts/Base.astro';
import QuizApp from '@/components/QuizApp.astro';
import { quizT } from '@/lib/quiz';
import { tr } from '@/lib/i18n';

const lang = 'ko' as const;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const title = `${quizT('pageTitle', lang)} — ${tr('siteName', lang)}`;
const desc = quizT('pageDesc', lang);
---

<Base
  title={title}
  description={desc}
  lang={lang}
  canonicalPath="/quiz/"
  ogImage="/og-quiz.svg"
>
  <QuizApp lang={lang} base={base} />
</Base>
