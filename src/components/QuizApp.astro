---
/**
 * QuizApp — 통합 퀴즈 UI.
 * 빌드 타임에 6 페르소나 × 12 추천 모두 정적 HTML로 렌더.
 * 클라이언트(quiz.client.ts)가 URL state(?type=X) 와 사용자 입력에 따라
 * 적절한 섹션만 토글 표시.
 */
import {
  QUESTIONS,
  PERSONAS,
  PERSONA_IDS,
  PERSONA_DISTRIBUTION,
  PERSONA_CHARACTER,
  characterImg,
  quizT,
  getAllRecommendations,
  type PersonaId,
} from '@/lib/quiz';
import type { Lang } from '@/lib/i18n';
import ItemCard from './ItemCard.astro';
import AdSlot from './AdSlot.astro';
import PersonaExtras from './PersonaExtras.astro';

interface Props {
  lang: Lang;
  base: string;
}

const { lang, base } = Astro.props;

// 빌드 타임에 추천 6×12 계산 — 정적 HTML 임베드
const recommendations = getAllRecommendations();
---

<section id="quiz-app" data-lang={lang}>

  {/* ── 1. 시작 화면 = 테스트 허브 ──────────────────────── */}
  <div class="quiz-screen quiz-intro" data-screen="intro">
    <div class="quiz-intro-emoji" aria-hidden="true">🎒</div>
    <h1 class="quiz-intro-title">{lang === 'ko' ? '여행 심리테스트' : lang === 'en' ? 'Travel Psychology Tests' : lang === 'ja' ? '旅の心理テスト' : '旅行心理测试'}</h1>
    <p class="quiz-intro-desc">{lang === 'ko' ? '나에게 맞는 테스트를 골라보세요' : lang === 'en' ? 'Pick a test to discover your travel self' : lang === 'ja' ? '自分に合うテストを選んでね' : '选一个测试,发现你的旅行风格'}</p>

    <div class="test-hub">
      {/* ① 여행 성향 테스트 (캐릭터) */}
      <div class="test-card test-card-primary">
        <div class="test-card-chars" aria-hidden="true">🦌🦊🐻</div>
        <h2 class="test-card-title">{quizT('pageTitle', lang)}</h2>
        <p class="test-card-desc">{lang === 'ko' ? '6가지 동물 캐릭터로 보는 내 여행 스타일' : lang === 'en' ? '6 animal characters reveal your travel style' : lang === 'ja' ? '6つの動物キャラで分かる旅スタイル' : '6种动物角色看你的旅行风格'} · {quizT('startCta', lang)}</p>
        <button type="button" class="btn quiz-start-btn" id="quiz-start-btn">{quizT('start', lang)} →</button>
      </div>
      {/* ② 여행 MBTI (정밀 16유형) */}
      <a href={lang === 'ko' ? `${base}/quiz/dna/` : `${base}/${lang}/quiz/dna/`} class="test-card test-card-dna">
        <div class="test-card-chars" aria-hidden="true">🧬</div>
        <h2 class="test-card-title">{lang === 'ko' ? '여행 MBTI' : lang === 'en' ? 'Travel MBTI' : lang === 'ja' ? '旅行MBTI' : '旅行MBTI'}</h2>
        <p class="test-card-desc">{lang === 'ko' ? '4축 16유형 정밀 분석' : lang === 'en' ? '4 axes · 16 types · deep analysis' : lang === 'ja' ? '4軸16型の精密分析' : '4轴16型精准分析'} · {lang === 'ko' ? '8문항 90초' : lang === 'en' ? '8 Qs / 90s' : lang === 'ja' ? '8問90秒' : '8题90秒'}</p>
        <span class="test-card-cta">{lang === 'ko' ? '분석하러 가기 →' : lang === 'en' ? 'Analyze →' : lang === 'ja' ? '分析する →' : '去分析 →'}</span>
      </a>
    </div>
  </div>

  {/* ── 2. 질문 화면 ─────────────────────────────────── */}
  <div class="quiz-screen quiz-questions" data-screen="questions" hidden>
    <div class="quiz-progress">
      <div class="quiz-progress-bar"><div class="quiz-progress-fill" id="quiz-progress-fill"></div></div>
      <p class="quiz-progress-text">
        <span id="quiz-q-current">1</span><span>{quizT('questionOf', lang)}</span>
      </p>
    </div>

    {QUESTIONS.map((q, idx) => (
      <div class="quiz-question" data-q-index={idx} hidden={idx > 0}>
        <h2 class="quiz-q-text">{q.question[lang]}</h2>
        <div class="quiz-options" role="radiogroup">
          {q.options.map((o) => (
            <button type="button" class="quiz-option" data-option-id={o.id}>
              {o.label[lang]}
            </button>
          ))}
        </div>
      </div>
    ))}

    <div class="quiz-nav">
      <button type="button" class="btn-link quiz-prev-btn" id="quiz-prev-btn" hidden>
        ← {quizT('prev', lang)}
      </button>
    </div>
  </div>

  {/* ── 3. 결과 화면 — 페르소나별 한 블록씩, JS가 매칭되는 것만 표시 ── */}
  {PERSONA_IDS.map((pid) => {
    const persona = PERSONAS[pid as PersonaId];
    const items = recommendations[pid as PersonaId];
    return (
      <div class="quiz-screen quiz-result" data-screen="result" data-persona-id={pid} hidden>
        <!-- 심리테스트 결과 히어로 카드 — 페르소나별 그라데이션 -->
        <div
          class="quiz-result-card"
          style={`background: linear-gradient(135deg, ${persona.gradient.from}, ${persona.gradient.to});`}
        >
          <p class="quiz-result-label">{quizT('yourType', lang)}</p>
          <img class="quiz-result-char" src={`${base}${characterImg(pid as PersonaId)}`} alt={PERSONA_CHARACTER[pid as PersonaId].name[lang]} width="160" height="160" loading="eager" />
          <h1 class="quiz-result-name">{PERSONA_CHARACTER[pid as PersonaId].name[lang]}</h1>
          <p class="quiz-result-type">{persona.emoji} {persona.name[lang]}</p>
          <p class="quiz-result-tagline">"{persona.tagline[lang]}"</p>
        </div>

        <p class="quiz-result-desc">{persona.description[lang]}</p>

        <!-- 바이럴 강화: 희귀도 배지 · 한 줄 요약 · 여행 궁합 -->
        <PersonaExtras persona={persona} lang={lang} base={base} />

        <!-- 특성 (traits) -->
        <section class="quiz-traits">
          <h2 class="quiz-section-h">{quizT('traitsHeading', lang)}</h2>
          <ul class="quiz-traits-list">
            {persona.traits[lang].map((t) => <li class="quiz-trait">{t}</li>)}
          </ul>
        </section>

        <!-- 매칭 분포 — 클라이언트 JS가 채움 (data-breakdown 영역) -->
        <section class="quiz-breakdown" data-breakdown>
          <h2 class="quiz-section-h">{quizT('breakdownHeading', lang)}</h2>
          <div class="quiz-breakdown-list" data-breakdown-list>
            <!-- JS가 6 페르소나 % 막대 채움. 정적 마크업이 없으면 노출되지 않음. -->
          </div>
        </section>

        <!-- 통계: 비슷한 유형 비율 -->
        <section class="quiz-stat">
          <h2 class="quiz-section-h">{quizT('statHeading', lang)}</h2>
          <p class="quiz-stat-line">
            <strong style={`color: ${persona.gradient.from};`}>
              {PERSONA_DISTRIBUTION[pid as PersonaId]}%
            </strong>
            <span>{persona.name[lang]} ({lang === 'ko' ? '약' : '~'}{Math.round(1000 * PERSONA_DISTRIBUTION[pid as PersonaId] / 100)}/1,000)</span>
          </p>
        </section>

        <!-- 결과 상단 광고 (가장 효과적인 위치 — 사용자가 결과 보려고 머무는 시점) -->
        <AdSlot lang={lang} layout="horizontal" />

        <!-- 공유 -->
        <div class="quiz-actions">
          <button type="button" class="btn-share quiz-share-btn" data-share-action="native">
            ↗ {quizT('share', lang)}
          </button>
          <button type="button" class="btn-share quiz-share-btn" data-share-action="copy">
            📋 {quizT('shareCopy', lang)}
          </button>
          <button type="button" class="btn-share quiz-share-btn" data-share-action="twitter">
            𝕏 {quizT('shareTwitter', lang)}
          </button>
        </div>

        <!-- 친구 초대 카드 (바이럴) -->
        <section class="quiz-invite">
          <div class="quiz-invite-emoji" aria-hidden="true">🤝</div>
          <div class="quiz-invite-body">
            <h3 class="quiz-invite-title">{quizT('inviteFriend', lang)}</h3>
            <p class="quiz-invite-desc">{quizT('inviteFriendDesc', lang)}</p>
            <button type="button" class="quiz-invite-btn quiz-share-btn" data-share-action="copy">
              📋 {quizT('shareCopy', lang)}
            </button>
          </div>
        </section>

        <!-- 추천 — 왜 이렇게 추천했는지 설명 포함 -->
        <section class="quiz-recommendations">
          <h2 class="section-title">{quizT('recommendations', lang)}</h2>
          <p class="quiz-why-pick">{quizT('whyHeading', lang)} — {persona.whyRecommend[lang]}</p>
          <div class="grid">
            {items.map((item) => (
              <ItemCard item={item} lang={lang} base={base} />
            ))}
          </div>
        </section>

        <!-- 결과 하단 광고 (카드 본 후 자연스러운 위치) -->
        <AdSlot lang={lang} layout="rectangle" />

        <div class="quiz-retake">
          <button type="button" class="btn quiz-retake-btn">
            ↻ {quizT('retake', lang)}
          </button>
        </div>
      </div>
    );
  })}
</section>

<script>
  import { initQuiz } from '@/scripts/quiz.client';
  const root = document.getElementById('quiz-app');
  if (root) initQuiz(root);
</script>

<style>
  /* 퀴즈 페이지 — 모바일 우선, 검정+노랑 톤 */
  #quiz-app { max-width: 880px; margin: 0 auto; padding: 24px 16px 80px; }

  .quiz-screen { animation: fadeIn 0.3s ease-out; }
  @keyframes fadeIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

  /* Intro */
  .quiz-intro { text-align: center; padding: 48px 16px; }
  .quiz-intro-emoji { font-size: 64px; line-height: 1; margin-bottom: 16px; }
  .quiz-intro-title { font-size: clamp(1.6rem, 4vw, 2.2rem); margin: 0 0 12px; letter-spacing: -0.02em; }
  .quiz-intro-desc { color: var(--ink-3, #525252); margin: 0 0 4px; line-height: 1.5; }
  .quiz-intro-meta { color: var(--ink-4, #a3a3a3); font-size: 0.85rem; margin: 0 0 28px; }
  .quiz-start-btn { font-size: 1.05rem; padding: 14px 32px; }

  /* 테스트 허브 카드 */
  .test-hub { display: grid; gap: 14px; max-width: 460px; margin: 28px auto 0; }
  .test-card {
    background: #fff; border: 1.5px solid #e5e5e5; border-radius: 18px;
    padding: 24px 20px; text-align: center; text-decoration: none; color: inherit;
    display: block; transition: transform 0.12s ease, box-shadow 0.15s ease, border-color 0.15s ease;
  }
  .test-card:hover { transform: translateY(-3px); box-shadow: 0 8px 24px rgba(0,0,0,0.1); border-color: #facc15; }
  .test-card-primary { border-color: #facc15; background: #fffdf5; }
  .test-card-chars { font-size: 42px; line-height: 1; margin-bottom: 10px; letter-spacing: 2px; }
  .test-card-title { font-size: 1.3rem; margin: 0 0 6px; font-weight: 800; letter-spacing: -0.02em; }
  .test-card-desc { font-size: 0.86rem; color: #525252; margin: 0 0 16px; line-height: 1.55; }
  .test-card-dna .test-card-cta {
    display: inline-block; font-weight: 800; font-size: 0.95rem;
    color: #171717; background: #f0f0f0; padding: 11px 24px; border-radius: 999px;
  }
  .test-card-dna:hover .test-card-cta { background: #facc15; }

  /* 다른 테스트 안내 카드 */
  .quiz-other-tests { margin-top: 36px; max-width: 480px; margin-left: auto; margin-right: auto; }
  .quiz-other-tests-eyebrow { font-size: 0.72rem; font-weight: 700; color: #737373; text-transform: uppercase; letter-spacing: 0.12em; margin: 0 0 10px; text-align: center; }
  .quiz-other-test-card {
    display: flex; align-items: center; gap: 14px;
    padding: 14px 16px;
    background: #171717; color: #fff;
    border-radius: 14px;
    text-decoration: none;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .quiz-other-test-card:hover { background: #000; transform: translateY(-2px); }
  .qot-emoji { font-size: 28px; line-height: 1; flex-shrink: 0; }
  .qot-body { flex: 1; min-width: 0; text-align: left; display: flex; flex-direction: column; gap: 2px; }
  .qot-title { font-size: 0.98rem; font-weight: 800; color: #facc15; }
  .qot-desc { font-size: 0.78rem; color: #a3a3a3; }
  .qot-arrow { color: #facc15; font-size: 1.2rem; font-weight: 800; }

  /* Progress */
  .quiz-progress { margin-bottom: 32px; }
  .quiz-progress-bar { height: 6px; background: #f0f0f0; border-radius: 999px; overflow: hidden; }
  .quiz-progress-fill { height: 100%; background: #facc15; border-radius: 999px; width: 17%; transition: width 0.3s ease; }
  .quiz-progress-text { margin: 8px 0 0; font-size: 0.85rem; color: #737373; text-align: center; font-feature-settings: "tnum"; }

  /* Question */
  .quiz-question { animation: fadeIn 0.3s ease-out; }
  .quiz-q-text { font-size: clamp(1.2rem, 3vw, 1.55rem); margin: 0 0 24px; letter-spacing: -0.015em; line-height: 1.35; }
  .quiz-options { display: flex; flex-direction: column; gap: 12px; }
  .quiz-option {
    width: 100%;
    text-align: left;
    padding: 18px 20px;
    background: #fff;
    border: 2px solid #e5e5e5;
    border-radius: 14px;
    font-size: 1rem;
    font-weight: 500;
    color: #171717;
    cursor: pointer;
    transition: border-color 0.15s ease, background 0.15s ease, transform 0.06s ease;
    line-height: 1.4;
  }
  .quiz-option:hover { border-color: #171717; }
  .quiz-option:active { transform: scale(0.985); }
  .quiz-option.is-selected { border-color: #facc15; background: #fefce8; }

  .quiz-nav { margin-top: 24px; text-align: center; }
  .btn-link { background: none; border: 0; color: #737373; cursor: pointer; padding: 8px 16px; font-size: 0.9rem; }
  .btn-link:hover { color: #171717; }

  /* Result hero card — 페르소나 그라데이션 */
  .quiz-result-card {
    text-align: center;
    padding: 36px 24px 32px;
    border-radius: 24px;
    color: #fff;
    box-shadow: 0 8px 32px rgba(0,0,0,0.18);
    margin-bottom: 24px;
    animation: cardIn 0.5s cubic-bezier(0.2, 0.7, 0.3, 1);
  }
  @keyframes cardIn {
    from { opacity: 0; transform: translateY(20px) scale(0.96); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .quiz-result-label {
    color: rgba(255,255,255,0.78);
    font-size: 0.92rem;
    margin: 0 0 4px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .quiz-result-char {
    width: 160px; height: 160px; object-fit: contain;
    margin: 8px auto 10px; display: block;
    filter: drop-shadow(0 6px 16px rgba(0,0,0,0.28));
  }
  .quiz-result-type {
    color: rgba(255,255,255,0.92); font-size: 0.95rem; font-weight: 700;
    margin: 0 0 6px;
  }
  .quiz-result-name {
    font-size: clamp(1.9rem, 6vw, 2.8rem);
    margin: 0 0 10px;
    letter-spacing: -0.025em;
    font-weight: 800;
    color: #fff;
    text-shadow: 0 2px 12px rgba(0,0,0,0.15);
  }
  .quiz-result-tagline {
    font-size: 1.05rem;
    color: rgba(255,255,255,0.95);
    font-weight: 500;
    margin: 0;
    font-style: italic;
  }
  .quiz-result-desc {
    color: #525252;
    line-height: 1.7;
    max-width: 620px;
    margin: 0 auto 24px;
    font-size: 0.95rem;
    text-align: center;
  }
  .quiz-section-h {
    font-size: 1rem;
    margin: 0 0 12px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: #171717;
  }
  /* Traits */
  .quiz-traits { margin: 0 0 24px; padding: 0 4px; }
  .quiz-traits-list {
    list-style: none; padding: 0; margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 8px;
  }
  .quiz-trait {
    background: #fafafa;
    border: 1px solid #f0f0f0;
    border-radius: 12px;
    padding: 12px 14px;
    font-size: 0.92rem;
    color: #171717;
    text-align: center;
    line-height: 1.4;
  }
  /* Breakdown — 6 페르소나 매칭 % */
  .quiz-breakdown { margin: 0 0 28px; }
  .quiz-breakdown-list { display: flex; flex-direction: column; gap: 8px; }
  .quiz-bd-row {
    display: grid;
    grid-template-columns: 96px 1fr 40px;
    align-items: center;
    gap: 10px;
    font-size: 0.86rem;
  }
  .quiz-bd-name { color: #525252; font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .quiz-bd-row.is-winner .quiz-bd-name { color: #171717; font-weight: 700; }
  .quiz-bd-bar { height: 8px; background: #f0f0f0; border-radius: 999px; overflow: hidden; }
  .quiz-bd-fill { display: block; height: 100%; background: #d4d4d4; border-radius: 999px; transition: width 0.6s cubic-bezier(0.2, 0.7, 0.3, 1); }
  .quiz-bd-row.is-winner .quiz-bd-fill { background: #facc15; }
  .quiz-bd-pct { text-align: right; font-feature-settings: "tnum"; font-weight: 600; color: #171717; }
  /* Why pick — 추천 이유 멘트 */
  .quiz-why-pick {
    background: #fefce8;
    border-left: 3px solid #facc15;
    padding: 10px 14px;
    margin: 0 0 16px;
    border-radius: 8px;
    color: #525252;
    font-size: 0.88rem;
    line-height: 1.6;
  }
  /* 통계 카드 */
  .quiz-stat {
    background: #fafafa;
    border: 1px solid #f0f0f0;
    border-radius: 12px;
    padding: 14px 16px;
    margin: 0 0 24px;
  }
  .quiz-stat-line { display: flex; align-items: baseline; gap: 8px; margin: 0; font-size: 0.95rem; }
  .quiz-stat-line strong { font-size: 1.7rem; font-weight: 800; line-height: 1; font-feature-settings: "tnum"; }
  .quiz-stat-line span { color: #525252; }
  /* 친구 초대 카드 */
  .quiz-invite {
    background: linear-gradient(135deg, #171717, #404040);
    color: #fff;
    border-radius: 16px;
    padding: 18px;
    margin: 0 0 24px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .quiz-invite-emoji { font-size: 48px; line-height: 1; flex-shrink: 0; }
  .quiz-invite-body { flex: 1; min-width: 0; }
  .quiz-invite-title { margin: 0 0 4px; font-size: 1.05rem; font-weight: 800; color: #facc15; }
  .quiz-invite-desc { margin: 0 0 10px; font-size: 0.85rem; color: rgba(255,255,255,0.8); line-height: 1.4; }
  .quiz-invite-btn {
    background: #facc15;
    color: #171717;
    border: 0;
    padding: 8px 18px;
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 700;
    cursor: pointer;
  }
  .quiz-invite-btn:hover { background: #fde047; }
  @media (max-width: 480px) {
    .quiz-invite { flex-direction: column; text-align: center; }
  }

  .quiz-actions {
    display: flex; flex-wrap: wrap; gap: 8px; justify-content: center;
    margin: 0 0 40px; padding: 0 8px;
  }
  .btn-share {
    background: #171717; color: #fff;
    border: 0; padding: 10px 16px; border-radius: 999px;
    font-size: 0.88rem; font-weight: 600;
    cursor: pointer; transition: background 0.15s ease;
    letter-spacing: -0.005em;
  }
  .btn-share:hover { background: #000; }
  .btn-share[data-share-action="twitter"] { background: #1d9bf0; }
  .btn-share[data-share-action="copy"] { background: #facc15; color: #171717; }

  .quiz-recommendations { margin: 32px 0; }
  .quiz-recommendations .section-title { font-size: 1.25rem; margin: 0 0 16px; letter-spacing: -0.015em; }

  .quiz-retake { margin-top: 40px; text-align: center; }
  .quiz-retake-btn { background: transparent; color: #171717; border: 1px solid #e5e5e5; }
  .quiz-retake-btn:hover { background: #fafafa; }

  /* 모바일 */
  @media (max-width: 640px) {
    #quiz-app { padding: 16px 12px 64px; }
    .quiz-actions { flex-direction: row; flex-wrap: wrap; }
    .btn-share { font-size: 0.82rem; padding: 8px 14px; }
  }
</style>
