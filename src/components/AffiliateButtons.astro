---
import type { Item } from '@/lib/data';
import { AREA_CODE } from '@/lib/data';
import type { Lang } from '@/lib/i18n';
import { tr } from '@/lib/i18n';
import { agodaUrl, yanoljaUrl, bookingUrl, kkdayUrl, yeogiUrl } from '@/lib/affiliate';

interface Props {
  item: Item;
  lang: Lang;
}

const { item, lang } = Astro.props;
const region = AREA_CODE[item.areacode]?.[lang] ?? '';

const nearbyText: Record<Lang, string> = {
  ko: `${region} 인근 숙소를 찾아보세요.`,
  en: `Find stays near ${region}.`,
  ja: `${region}周辺の宿を探す。`,
  zh: `查找${region}附近的住宿。`,
};

// 1순위 숙소 버튼. 한국어 페이지는 여기어때(국내 숙소), 그 외 언어는 아고다.
// 유입의 85%가 네이버 모바일 검색 = 국내 사용자라, 한국어 쪽이 실질 수익원이다.
const primaryLabel: Record<Lang, string> = {
  ko: '여기어때에서 숙소 보기 →',
  en: 'View hotels on Agoda →',
  ja: 'Agodaでホテルを見る →',
  zh: '在Agoda查看酒店 →',
};

const secondaryLabel: Record<Lang, string> = {
  ko: '야놀자에서 검색 →',
  en: 'Search on Booking.com →',
  ja: 'Booking.comで検索 →',
  zh: '在Booking.com搜索 →',
};

// 공정위 추천·보증 심사지침 + 제휴 프로그램(여기어때 등) 필수 요건:
// "수수료를 받는다"만으로는 부족하고 '광고'임이 명시돼야 수익이 인정된다.
// 이 문구가 빠지면 해당 링크로 발생한 수익이 지급되지 않을 수 있음.
const disclosure: Record<Lang, string> = {
  ko: '[광고] 이 문단의 링크는 제휴 링크로, 예약 시 운영자가 일정액의 수수료를 지급받습니다.',
  en: '[Ad] The links above are affiliate links. This site earns a commission from qualifying bookings.',
  ja: '[広告] 上記はアフィリエイトリンクです。ご予約に応じて運営者が所定の手数料を受け取ります。',
  zh: '[广告] 以上为联盟推广链接,通过链接预订时本站将获得一定佣金。',
};

const kkdayLabel: Record<Lang, string> = {
  ko: '🎫 투어·액티비티 (KKday)',
  en: '🎫 Tours & activities (KKday)',
  ja: '🎫 ツアー·体験 (KKday)',
  zh: '🎫 行程·体验 (KKday)',
};
const moreTitle: Record<Lang, string> = {
  ko: '🧳 여행 준비',
  en: '🧳 Trip planning',
  ja: '🧳 旅行の準備',
  zh: '🧳 行程准备',
};

const primaryHref = lang === 'ko' ? yeogiUrl(item) : agodaUrl(item, lang);
const primaryProvider = lang === 'ko' ? 'yeogi' : 'agoda';
const secondaryHref = lang === 'ko' ? yanoljaUrl(item) : bookingUrl(item);
---

<section class="detail-affiliate">
  <h2>🏨 {tr('nearbyStay', lang)}</h2>
  <p class="muted">{nearbyText[lang]}</p>
  <div class="affiliate-buttons">
    <a
      href={primaryHref}
      target="_blank"
      rel="noopener nofollow sponsored"
      class="btn btn-affiliate"
      data-affiliate={primaryProvider}
      data-item-id={item.id}
    >{primaryLabel[lang]}</a>
    <a
      href={secondaryHref}
      target="_blank"
      rel="noopener nofollow sponsored"
      class="btn btn-affiliate"
      data-affiliate={lang === 'ko' ? 'yanolja' : 'booking'}
      data-item-id={item.id}
    >{secondaryLabel[lang]}</a>
  </div>

  <h3 class="detail-affiliate-sub">{moreTitle[lang]}</h3>
  <div class="affiliate-buttons">
    <a
      href={kkdayUrl(item, lang)}
      target="_blank"
      rel="noopener nofollow sponsored"
      class="btn btn-affiliate btn-affiliate-secondary"
      data-affiliate="kkday"
      data-item-id={item.id}
    >{kkdayLabel[lang]}</a>
  </div>
  <p class="affiliate-disclosure">{disclosure[lang]}</p>
</section>

<script is:inline>
  // 어필리에이트 클릭 추적 (GA4 event) — gtag 없으면 무시
  document.querySelectorAll('a[data-affiliate]').forEach(function (a) {
    a.addEventListener('click', function () {
      if (typeof window.gtag !== 'function') return;
      window.gtag('event', 'affiliate_click', {
        provider: a.dataset.affiliate,
        item_id: a.dataset.itemId || '',
        page_path: window.location.pathname,
      });
    });
  });
</script>
