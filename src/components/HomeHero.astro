---
/**
 * 홈 상단 Hero — 강력한 퀴즈 CTA + 통계.
 * LandingHero보다 작고 즉시 Explorer로 스크롤 유도.
 */
import type { Lang } from '@/lib/i18n';
import { tr } from '@/lib/i18n';
import { festivals, attractions } from '@/lib/data';

interface Props { lang: Lang; base: string; }
const { lang, base } = Astro.props;
const prefix = lang === 'ko' ? '' : `/${lang}`;
const allCount = festivals.length + attractions.length;

const L = {
  quizCta: { ko: '🎒 여행 성향 테스트', en: '🎒 Travel Quiz', ja: '🎒 旅行性向テスト', zh: '🎒 旅行测试' },
  quizSub: {
    ko: '6문항으로 알아보는 나만의 여행 스타일',
    en: 'Your travel style in 6 questions',
    ja: '6問でわかる旅スタイル',
    zh: '6道题了解你的旅行风格',
  },
  exploreCta: { ko: '↓ 둘러보기', en: '↓ Explore', ja: '↓ 探す', zh: '↓ 浏览' },
  attractionsLabel: { ko: '여행지', en: 'Attractions', ja: '観光地', zh: '景点' },
  attractionsDesc: {
    ko: '전국 명소·자연·문화재',
    en: 'Sights, nature, heritage',
    ja: '名所・自然・文化財',
    zh: '名胜·自然·文化遗产',
  },
  festivalsLabel: { ko: '축제', en: 'Festivals', ja: 'お祭り', zh: '节庆' },
  festivalsDesc: {
    ko: '계절별 축제·이벤트',
    en: 'Seasonal events',
    ja: '季節のお祭り',
    zh: '应季节日活动',
  },
} as const;
function L_(k: keyof typeof L): string { return L[k][lang]; }
---

<section class="home-hero">
  <div class="home-hero-inner">
    <h1 class="home-hero-title">{tr('siteName', lang)}</h1>
    <p class="home-hero-sub">{tr('siteDesc', lang)}</p>
    <p class="home-hero-stats">
      <strong>{allCount.toLocaleString(lang)}</strong>
      <span> · 🎆 {festivals.length.toLocaleString(lang)} {tr('festivals', lang)}</span>
      <span> · 🗺️ {attractions.length.toLocaleString(lang)} {tr('attractions', lang)}</span>
    </p>

    <div class="home-hero-cta-card">
      <p class="home-hero-cta-sub">{L_('quizSub')}</p>
      <a href={`${base}${prefix}/quiz/`} class="home-hero-cta-btn">{L_('quizCta')} →</a>
    </div>

    <!-- 여행지 / 축제 진입 카드 — 큰 두 개로 카테고리 명확화 -->
    <div class="home-hero-pillars">
      <a href={`${base}${prefix}/attractions/`} class="home-hero-pillar">
        <div class="home-hero-pillar-icon" aria-hidden="true">🗺️</div>
        <div class="home-hero-pillar-text">
          <strong class="home-hero-pillar-name">{L_('attractionsLabel')}</strong>
          <span class="home-hero-pillar-count">{attractions.length.toLocaleString(lang)}</span>
          <span class="home-hero-pillar-desc">{L_('attractionsDesc')}</span>
        </div>
      </a>
      <a href={`${base}${prefix}/festivals/`} class="home-hero-pillar">
        <div class="home-hero-pillar-icon" aria-hidden="true">🎆</div>
        <div class="home-hero-pillar-text">
          <strong class="home-hero-pillar-name">{L_('festivalsLabel')}</strong>
          <span class="home-hero-pillar-count">{festivals.length.toLocaleString(lang)}</span>
          <span class="home-hero-pillar-desc">{L_('festivalsDesc')}</span>
        </div>
      </a>
    </div>

    <a href="#explorer" class="home-hero-scroll">{L_('exploreCta')}</a>
  </div>
</section>

<style>
  .home-hero {
    margin: 0 -16px 24px;
    padding: 56px 24px 48px;
    background: #171717;
    color: #fff;
    text-align: center;
    border-radius: 0 0 24px 24px;
    position: relative;
    overflow: hidden;
  }
  .home-hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(700px 350px at 85% 15%, rgba(250, 204, 21, 0.18), transparent 60%),
      radial-gradient(500px 250px at 15% 90%, rgba(250, 204, 21, 0.10), transparent 60%);
    pointer-events: none;
  }
  .home-hero-inner { position: relative; max-width: 720px; margin: 0 auto; }
  .home-hero-title {
    font-size: clamp(1.7rem, 5vw, 2.4rem);
    margin: 0 0 12px;
    letter-spacing: -0.025em;
    font-weight: 800;
    line-height: 1.2;
    color: #fff;
  }
  .home-hero-sub {
    color: #d4d4d4;
    font-size: clamp(0.92rem, 1.7vw, 1.05rem);
    margin: 0 0 16px;
    line-height: 1.5;
  }
  .home-hero-stats {
    color: #a3a3a3;
    font-size: 0.88rem;
    margin: 0 0 28px;
    font-feature-settings: "tnum";
  }
  .home-hero-stats strong { color: #facc15; font-weight: 700; }

  .home-hero-cta-card {
    background: rgba(250, 204, 21, 0.10);
    border: 1px solid rgba(250, 204, 21, 0.35);
    border-radius: 16px;
    padding: 20px 18px;
    margin: 0 auto 18px;
    max-width: 480px;
  }
  .home-hero-cta-sub {
    color: #fde68a;
    font-size: 0.88rem;
    margin: 0 0 12px;
    letter-spacing: -0.005em;
  }
  .home-hero-cta-btn {
    display: inline-block;
    background: #facc15;
    color: #171717;
    padding: 14px 28px;
    border-radius: 999px;
    font-size: 1rem;
    font-weight: 800;
    text-decoration: none;
    letter-spacing: -0.005em;
    transition: background 0.15s ease, transform 0.1s ease;
  }
  .home-hero-cta-btn:hover { background: #fde047; }
  .home-hero-cta-btn:active { transform: scale(0.97); }

  /* 여행지/축제 두 개 큰 카드 */
  .home-hero-pillars {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin: 0 auto 18px;
    max-width: 480px;
  }
  .home-hero-pillar {
    display: flex;
    align-items: center;
    gap: 12px;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.18);
    border-radius: 14px;
    padding: 14px 14px;
    color: #fff;
    text-decoration: none;
    text-align: left;
    transition: background 0.15s ease, border-color 0.15s ease, transform 0.1s ease;
  }
  .home-hero-pillar:hover { background: rgba(250, 204, 21, 0.12); border-color: rgba(250, 204, 21, 0.45); }
  .home-hero-pillar:active { transform: scale(0.98); }
  .home-hero-pillar-icon { font-size: 1.9rem; line-height: 1; flex-shrink: 0; }
  .home-hero-pillar-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .home-hero-pillar-name { font-size: 1rem; font-weight: 800; line-height: 1.2; }
  .home-hero-pillar-count { font-size: 0.78rem; color: #facc15; font-weight: 700; font-feature-settings: "tnum"; }
  .home-hero-pillar-desc { font-size: 0.72rem; color: rgba(255,255,255,0.6); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .home-hero-scroll {
    display: inline-block;
    margin-top: 8px;
    color: rgba(255,255,255,0.6);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .home-hero-scroll:hover { color: #fff; }

  @media (max-width: 640px) {
    .home-hero { padding: 48px 16px 40px; }
  }
</style>
