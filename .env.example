# ────────────────────────────────────────────────────────────
# 환경 변수 예시 — .env 로 복사 후 실제 값 채워서 사용.
# Astro에선 'PUBLIC_' 접두사가 있어야 클라이언트 사이드에서 접근 가능.
# ────────────────────────────────────────────────────────────

# 1) TourAPI — 빌드 타임 데이터 수집 (npm run fetch)
#    https://www.data.go.kr/data/15101578/openapi.do 에서 발급 (디코딩된 키)
TOURAPI_KEY=발급받은_TourAPI_키

# 2) Google AdSense (광고 수익화 ⭐)
#    https://adsense.google.com 가입 → 사이트 등록 → 클라이언트 ID 발급
#    형식: ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
PUBLIC_ADSENSE_SLOT_DEFAULT=XXXXXXXXXX

# 3) Google Analytics 4 (트래픽 분석)
#    https://analytics.google.com 에서 측정 ID 발급
#    형식: G-XXXXXXXXXX
PUBLIC_GA_ID=G-XXXXXXXXXX

# 4) (선택) Contact 이메일 — privacy / about 페이지에 표시
#    아직 i18n 라벨에만 사용되지 않음, 추가 옵션
# PUBLIC_CONTACT_EMAIL=hello@example.com

# 5) 어필리에이트 ID (제휴 수익 ⭐)
#    각 서비스 제휴 프로그램 가입 후 발급. lib/affiliate.ts 가 자동 부착한다.
#    비워두면 링크는 그대로 나가고 수수료만 0원이 된다 = 지금 상태.
#    Agoda Partners → cid / Booking.com affiliate → aid
# AGODA_AFFILIATE_ID=
# BOOKING_AFFILIATE_ID=
# KKDAY_AFFILIATE_ID=
# SKYSCANNER_AFFILIATE_ID=
#
#    파라미터 이름이 프로그램 안내와 다르면 코드 수정 없이 덮어쓰기:
# AGODA_AFFILIATE_PARAM=cid
#
#    야놀자처럼 국내 제휴 네트워크(링크프라이스 등) 딥링크만 되는 곳은
#    "원본 URL을 뒤에 붙이는" 프리픽스를 그대로 넣는다:
# YANOLJA_DEEPLINK_PREFIX=https://click.linkprice.com/click.php?m=...&a=...&l=0&l_cd1=0&u=

# ────────────────────────────────────────────────────────────
# 사용:
#   npm run build       # 데이터 수집 + 빌드
#   npm run build:nofetch  # 데이터 수집 스킵 (기존 JSON 사용)
#   npm run preview     # 로컬 확인
# ────────────────────────────────────────────────────────────
