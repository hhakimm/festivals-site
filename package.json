{
  "name": "festivals-site-astro",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "fetch": "tsx --env-file=.env scripts/fetch-tourapi.ts",
    "fetch:ci": "tsx scripts/fetch-tourapi.ts",
    "fetch:i18n": "tsx --env-file=.env scripts/fetch-i18n-titles.ts",
    "fetch:i18n:ci": "tsx scripts/fetch-i18n-titles.ts",
    "fetch:stats": "tsx --env-file=.env scripts/fetch-stats.ts",
    "fetch:stats:ci": "tsx scripts/fetch-stats.ts",
    "fetch:overviews": "tsx --env-file=.env scripts/fetch-overviews.ts",
    "fetch:overviews:ci": "tsx scripts/fetch-overviews.ts",
    "og:png": "tsx scripts/og-to-png.ts",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "npm run fetch && npm run og:png && astro build",
    "build:nofetch": "npm run og:png && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^4.16.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
